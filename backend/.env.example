PORT=5000

# MongoDB connection URI
# Local:  mongodb://127.0.0.1:27017/school_admin_db
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/school_admin_db
MONGODB_URI=mongodb://127.0.0.1:27017/school_admin_db

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
